server {
    listen ${PORT};
    server_name localhost;

    # Client request header buffers for large cookies / debug payloads
    client_header_buffer_size 16k;
    large_client_header_buffers 4 64k;

    root /usr/share/nginx/html;
    index index.html;

    # Do not issue redirects with internal Cloud Run port
    absolute_redirect off;
    port_in_redirect off;

    # Raw origin HTML snapshots served as text/plain so Cloudflare HTMLRewriter never mutates them
    location /raw-origin/ {
        default_type text/plain;
        add_header Content-Type "text/plain; charset=utf-8" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    # Static JS/CSS assets (no-cache during testing so updates take effect immediately)
    location /assets/ {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    # Serve each test route's static HTML directly (200 OK without 301 redirect)
    location / {
        default_type text/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri $uri/index.html $uri.html =404;
    }

    # Health check endpoint
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }
}
