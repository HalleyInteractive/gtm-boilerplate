server {
    listen ${PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # DNS resolver for dynamic proxy_pass
    resolver 8.8.8.8 8.8.4.4 valid=300s ipv6=off;
    resolver_timeout 5s;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # =========================================================================
    # Optimized Wildcard Route for Google Tag Gateway (GTG) Manual Proxy
    # Routes script serving, telemetry, and health check routes to fps.goog
    # =========================================================================

    # Redirect exact measurement path without trailing slash to preserve query parameters
    location = ${MEASUREMENT_PATH} {
        return 301 $scheme://$http_host$uri/$is_args$args;
    }

    location ~* ^${MEASUREMENT_PATH}/(.*)$ {
        # 1. Forward BOTH script serving and data collection to your unique first-party backend
        proxy_pass https://${GTG_TAG_ID}.fps.goog/$1$is_args$args;

        # 2. Rewrite Host header so Google knows which container configuration to serve (Critical!)
        proxy_set_header Host ${GTG_TAG_ID}.fps.goog;

        # 3. Connection & SSL security settings
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_buffering off;

        # 4. Forward standard visitor headers
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Referer $http_referer;

        # 5. Forward visitor geolocation data (Passed from CDN/LB or client headers)
        proxy_set_header X-Forwarded-Country $http_x_forwarded_country;
        proxy_set_header X-Forwarded-Region $http_x_forwarded_region;
        proxy_set_header X-Forwarded-CountryRegion $http_x_forwarded_countryregion;
    }

    # Static assets with caching
    location ~* \.(?:ico|css|js|gif|jpe?g|png|svg|woff2?|eot|ttf|otf|webmanifest)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public, max-age=15552000, immutable";
        try_files $uri =404;
    }

    # SPA routing - fallback all non-file routes to index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Health check endpoint
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    # Error page
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
